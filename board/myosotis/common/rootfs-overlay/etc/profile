# /etc/profile - interactive shells on Myosotis Linux

export PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PS1='\u@\h:\w\$ '

# Give the desktop user a working Wayland/PipeWire environment when
# logging in over the text console or serial port.
if [ "$(id -u)" = "1000" ]; then
	export XDG_RUNTIME_DIR=/run/user/1000
	export XDG_SESSION_TYPE=wayland
	export XDG_CURRENT_DESKTOP=myosotis
	export MOZ_ENABLE_WAYLAND=1
	export QT_QPA_PLATFORM=wayland
	export SDL_VIDEODRIVER=wayland
fi

# Keep the shell quiet about the missing UTF-8 locale fallback.
if [ -z "$LANG" ]; then
	export LANG=en_US.UTF-8
fi
