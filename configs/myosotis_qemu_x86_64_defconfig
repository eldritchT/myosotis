BR2_x86_64=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_ENABLE_LOCALE=y
BR2_GENERATE_LOCALE="en_US.UTF-8"
BR2_CCACHE=y
BR2_JLEVEL=6

BR2_INIT_SYSTEMD=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_SKELETON_DEFAULT=y
BR2_TARGET_GENERIC_HOSTNAME="qemu"
BR2_TARGET_GENERIC_ISSUE="myosotis"
# BR2_TARGET_GENERIC_GETTY is not set
BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW=y

BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MYOSOTIS_PATH)/board/myosotis/common/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_MYOSOTIS_PATH)/board/myosotis/common/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_MYOSOTIS_PATH)/board/myosotis/common/post-image.sh"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_MYOSOTIS_PATH)/board/myosotis/common/users.txt"

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_MYOSOTIS_PATH)/board/myosotis/qemu_x86_64/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
BR2_TARGET_ROOTFS_EXT2_LABEL="myosotis-root"
# BR2_TARGET_ROOTFS_TAR is not set

BR2_PACKAGE_SYSTEMD=y
BR2_PACKAGE_SKELETON_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_LOGIND=y
BR2_PACKAGE_SYSTEMD_TIMEDATE=y
BR2_PACKAGE_SYSTEMD_JOURNALD=y
BR2_PACKAGE_SYSTEMD_HOSTNAMED=y

BR2_PACKAGE_EUDEV=y
